# Local development (requires free Neon DB or local Postgres)
# Sign up: https://neon.tech — create project, copy connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET="change-me-in-production-use-long-random-string"
PORT=3001
PUBLIC_API_URL="http://localhost:3001"

# Optional web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Cloud only — voice file storage path (Fly volume)
# UPLOAD_DIR="/data/uploads"
