{
  "name": "stillhere",
  "private": true,
  "version": "0.1.0",
  "description": "Routine safety app — nudge Mom when she's late, alert family if she doesn't respond",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=server && npm run build --workspace=dashboard",
    "db:push": "npm run db:push --workspace=server",
    "db:studio": "npm run db:studio --workspace=server"
  },
  "workspaces": [
    "server",
    "dashboard",
    "mobile"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
